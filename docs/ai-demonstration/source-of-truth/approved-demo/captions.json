[
  {
    "startSec": 0.0,
    "endSec": 2.64,
    "text": "I'm Margot, your AI presenter."
  },
  {
    "startSec": 2.64,
    "endSec": 5.64,
    "text": "Today we will use Chat GPT to turn one"
  },
  {
    "startSec": 5.64,
    "endSec": 9.04,
    "text": "fictional cafe inquiry into a checked reply."
  },
  {
    "startSec": 9.04,
    "endSec": 11.08,
    "text": "Follow the steps on screen."
  },
  {
    "startSec": 11.08,
    "endSec": 13.4,
    "text": "Chat GPT is the application."
  },
  {
    "startSec": 13.4,
    "endSec": 15.08,
    "text": "Open AI makes it."
  },
  {
    "startSec": 15.08,
    "endSec": 17.08,
    "text": "Margot presents the lesson."
  },
  {
    "startSec": 17.08,
    "endSec": 19.04,
    "text": "Claude is an alternative."
  },
  {
    "startSec": 19.04,
    "endSec": 22.2,
    "text": "This demonstration stays in Chat GPT."
  },
  {
    "startSec": 22.2,
    "endSec": 29.24,
    "text": "20 lunchboxes at $18 plus $25 delivery gives $385."
  },
  {
    "startSec": 29.24,
    "endSec": 33.04,
    "text": "GST, date, address, availability and allergy"
  },
  {
    "startSec": 33.04,
    "endSec": 35.12,
    "text": "requirements are unknown."
  },
  {
    "startSec": 35.16,
    "endSec": 38.24,
    "text": "Open Chat GPT.com and sign in."
  },
  {
    "startSec": 38.28,
    "endSec": 39.96,
    "text": "Click the message box."
  },
  {
    "startSec": 42.68,
    "endSec": 45.480000000000004,
    "text": "Include prices and unknown details."
  },
  {
    "startSec": 54.04,
    "endSec": 55.64,
    "text": "Do not send yet."
  },
  {
    "startSec": 58.12,
    "endSec": 60.239999999999995,
    "text": "Add the prompt below the facts."
  },
  {
    "startSec": 60.239999999999995,
    "endSec": 63.33,
    "text": "Draft a short reply, show the breakdown and ask"
  },
  {
    "startSec": 63.33,
    "endSec": 65.0,
    "text": "for missing details."
  },
  {
    "startSec": 65.0,
    "endSec": 68.25,
    "text": "Do not invent, add GST, confirm an order or"
  },
  {
    "startSec": 68.25,
    "endSec": 70.75999999999999,
    "text": "promise allergy suitability."
  },
  {
    "startSec": 99.4,
    "endSec": 102.08,
    "text": "Press send and read the whole answer."
  },
  {
    "startSec": 107.44,
    "endSec": 109.0,
    "text": "Check with a calculator."
  },
  {
    "startSec": 109.0,
    "endSec": 114.2,
    "text": "20 times 18 plus 25 equals 385."
  },
  {
    "startSec": 142.2,
    "endSec": 144.88,
    "text": "If details are invented, type the correction"
  },
  {
    "startSec": 144.88,
    "endSec": 146.68,
    "text": "shown here in the same chat."
  },
  {
    "startSec": 180.28,
    "endSec": 182.2,
    "text": "Send, then check again."
  },
  {
    "startSec": 203.08,
    "endSec": 205.44,
    "text": "Practice with fictional information."
  },
  {
    "startSec": 205.44,
    "endSec": 208.12,
    "text": "Real customer details need your business's"
  },
  {
    "startSec": 208.12,
    "endSec": 208.72000000000003,
    "text": "approval."
  },
  {
    "startSec": 208.72000000000003,
    "endSec": 211.4,
    "text": "Removing a name may not remove identifying"
  },
  {
    "startSec": 211.4,
    "endSec": 212.52,
    "text": "information."
  },
  {
    "startSec": 212.52,
    "endSec": 214.4,
    "text": "Use your approved account."
  },
  {
    "startSec": 214.4,
    "endSec": 217.08,
    "text": "Check its current information handling rules"
  },
  {
    "startSec": 217.08,
    "endSec": 218.2,
    "text": "and connected apps."
  },
  {
    "startSec": 218.2,
    "endSec": 221.24,
    "text": "This exercise needs no inbox connection."
  },
  {
    "startSec": 221.24,
    "endSec": 224.84,
    "text": "A person checks every fact, price and promise."
  },
  {
    "startSec": 224.84,
    "endSec": 227.67000000000002,
    "text": "After approval, copy the draft into your own"
  },
  {
    "startSec": 227.67000000000002,
    "endSec": 228.24,
    "text": "email,"
  },
  {
    "startSec": 228.24,
    "endSec": 230.94,
    "text": "add the recipient, read it again and send"
  },
  {
    "startSec": 230.94,
    "endSec": 231.84,
    "text": "manually."
  },
  {
    "startSec": 231.84,
    "endSec": 235.09,
    "text": "The guide gives six task sequences with inputs,"
  },
  {
    "startSec": 235.09,
    "endSec": 236.60000000000002,
    "text": "prompts and checks."
  },
  {
    "startSec": 236.60000000000002,
    "endSec": 239.45,
    "text": "Try a handover, meeting follow-up or weekly"
  },
  {
    "startSec": 239.45,
    "endSec": 240.2,
    "text": "review."
  },
  {
    "startSec": 240.2,
    "endSec": 242.44,
    "text": "Keep missing information visible."
  },
  {
    "startSec": 242.44,
    "endSec": 245.29000000000002,
    "text": "Test five sample cases, including missing"
  },
  {
    "startSec": 245.29000000000002,
    "endSec": 247.48000000000002,
    "text": "prices and contradictory notes."
  },
  {
    "startSec": 247.48000000000002,
    "endSec": 249.96000000000004,
    "text": "Record checking time and corrections."
  },
  {
    "startSec": 249.96000000000004,
    "endSec": 252.81,
    "text": "Keep the workflow only if the checked result"
  },
  {
    "startSec": 252.81,
    "endSec": 253.48000000000002,
    "text": "helps."
  },
  {
    "startSec": 253.48000000000002,
    "endSec": 258.76,
    "text": "Open, brief, send, check, correct, approve."
  },
  {
    "startSec": 258.76,
    "endSec": 262.16,
    "text": "You have completed one workflow in chat GPT."
  },
  {
    "startSec": 262.16,
    "endSec": 265.06,
    "text": "Use the guide to practice, which everyday task"
  },
  {
    "startSec": 265.06,
    "endSec": 266.24,
    "text": "will you try first?"
  }
]